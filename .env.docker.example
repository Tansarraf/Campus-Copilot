# Docker Compose reads project-root `.env`.
# Copy `.env.example` to `.env` and fill in placeholders.
# This file is kept as an alias of the same template.

# Copy this file to `.env` in the project root before `docker compose up`.
# Never commit `.env`. Values below are placeholders only.

GEMINI_API_KEY=your_gemini_api_key
USE_MOCK_LLM=false

GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_GENERATION_MODEL=gemini-3.8-flash

JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRE_MINUTES=720

DATABASE_PATH=/data/campus_copilot.db
DOCUMENTS_DIR=/data/uploaded_documents

CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4
CONFIDENCE_THRESHOLD=0.72

CORS_ORIGINS=*
