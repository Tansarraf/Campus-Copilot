# Copy this file to `.env` in the project root before `docker compose up`.
# Never commit `.env`. Values below are placeholders only.

# Required for live Gemini embeddings and generation.
GEMINI_API_KEY=your_gemini_api_key

# Set true only for offline / mock-mode development.
USE_MOCK_LLM=false

# Model IDs available to your API key.
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_GENERATION_MODEL=gemini-3.8-flash

# Replace with a long random string before any shared or public host.
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRE_MINUTES=720

# docker-compose.yml also sets these to container paths.
DATABASE_PATH=/data/campus_copilot.db
DOCUMENTS_DIR=/data/uploaded_documents

CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4

# Cosine-similarity abstention threshold. Mock embeddings often need ~0.45.
# A real Gemini index in this project was calibrated around 0.72.
CONFIDENCE_THRESHOLD=0.72

# Comma-separated origins if the UI is not same-origin. * is used for local Docker.
CORS_ORIGINS=*

# Optional: bootstrap admin for `python scripts/seed_users.py` (local backend only).
# Required when creating the first admin; never commit the real value.
# INITIAL_ADMIN_PASSWORD=replace_with_a_local_admin_password
# CAMPUS_ADMIN_USERNAME=admin
# CAMPUS_ADMIN_FULL_NAME=Campus Admin

# Optional: Tesseract binary path if OCR is installed on the host (not in the Docker image).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
