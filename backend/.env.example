# Copy this file to .env and fill in real values before running the backend.

# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# If true (or if GEMINI_API_KEY is left as the placeholder above), the backend
# runs in mock mode: deterministic fake embeddings + a templated extractive
# answer instead of real Gemini calls. This lets you run and demo the whole
# pipeline (ingestion -> retrieval -> API -> frontend) with zero API cost
# while wiring things up. Retrieval quality and the evaluation numbers in the
# paper are only meaningful with USE_MOCK_LLM=false and a real key.
USE_MOCK_LLM=false

# Embedding + generation models (use IDs available to your API key)
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_GENERATION_MODEL=gemini-3.8-flash

JWT_SECRET=change_this_to_a_random_secret_before_any_real_deployment
JWT_EXPIRE_MINUTES=720

DATABASE_PATH=./campus_copilot.db
DOCUMENTS_DIR=./uploaded_documents

# Chunking
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Retrieval
TOP_K=4

# Cosine-similarity abstention threshold.
# Mock hash embeddings often need ~0.45. After migrating to
# models/gemini-embedding-001, calibrate against answerable vs
# unanswerable queries (real-mode baseline used 0.72).
CONFIDENCE_THRESHOLD=0.72
